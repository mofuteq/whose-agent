# Local-only dotenv example. Do not bake .env into container images.
#
# Mock workspace runs do not require credentials.
# Real model runs require OPENROUTER_API_KEY.
OPENROUTER_API_KEY=
WHOSE_AGENT_MODEL=openrouter:openai/gpt-4o-mini

# Optional Langfuse observability.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
